{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "machimaza content master data",
  "type": "object",
  "required": [
    "meta",
    "hook",
    "summary",
    "items",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "format",
        "publish_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-.+$"
        },
        "title": {
          "type": "string",
          "maxLength": 40
        },
        "subtitle": {
          "type": "string"
        },
        "category": {
          "enum": [
            "건강",
            "재테크",
            "생활꿀팁"
          ]
        },
        "format": {
          "enum": [
            "carousel",
            "poster",
            "hybrid"
          ]
        },
        "publish_date": {
          "type": "string",
          "format": "date"
        },
        "blog_url": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "axis": {
          "type": "object",
          "required": [
            "type",
            "buckets"
          ],
          "description": "자기 대입 축. 독자가 표 안에서 자기 자리를 찾게 하는 장치.",
          "properties": {
            "type": {
              "enum": [
                "소득구간",
                "연령대",
                "가구형태",
                "지역",
                "직업형태",
                "생활패턴"
              ]
            },
            "buckets": {
              "type": "array",
              "minItems": 3,
              "maxItems": 8,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "gateway": {
          "type": "boolean",
          "description": "관문 주제 여부 (도달용). 월 1회 이상 배정."
        },
        "dday": {
          "type": "string",
          "maxLength": 20,
          "description": "D-day 배지. 역산 캘린더에서 계산. 예: '신청 마감 D-14'"
        }
      }
    },
    "hook": {
      "type": "string",
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value",
          "detail",
          "source_id"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "maxLength": 24
          },
          "value": {
            "type": "string",
            "maxLength": 20
          },
          "detail": {
            "type": "string",
            "maxLength": 200
          },
          "source_id": {
            "type": "string",
            "pattern": "^S\\d{3}$"
          },
          "caption": {
            "type": "string",
            "maxLength": 60,
            "description": "영상 자막. 화면 텍스트(label/value)와 다른 문장이어야 합니다. 화면=사실, 자막=해석."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "issuer",
          "url",
          "tier",
          "effective_date",
          "verified_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{3}$"
          },
          "title": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "tier": {
            "enum": [
              1,
              2,
              3,
              4
            ],
            "description": "1=정부부처 2=공공기관 3=공신력언론 4=그외(사용금지)"
          },
          "effective_date": {
            "type": "string"
          },
          "verified_at": {
            "type": "string"
          }
        }
      }
    },
    "cta": {
      "type": "string"
    },
    "disclaimer_key": {
      "enum": [
        "health",
        "money",
        "none"
      ]
    }
  }
}